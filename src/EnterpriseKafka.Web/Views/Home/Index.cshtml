@{
    ViewData["Title"] = "EnterpriseKafka Test Console";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<div class="container py-4">
    <h3>EnterpriseKafka Internal Test Utility</h3>
    <p class="text-muted">Lightweight publisher/monitor shell for developers.</p>
    <div class="row g-3">
        <div class="col-md-6"><input id="topic" class="form-control" placeholder="Topic" /></div>
        <div class="col-md-6"><input id="key" class="form-control" placeholder="Partition Key" /></div>
        <div class="col-12"><textarea id="payload" class="form-control" rows="8" placeholder='{"id":1}'></textarea></div>
        <div class="col-12"><button class="btn btn-primary">Publish</button></div>
    </div>
</div>
